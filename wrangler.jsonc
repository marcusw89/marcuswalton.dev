{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "marcuswalton",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run the Worker before serving files so www requests can be redirected.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "marcuswalton.dev", "custom_domain": true },
    { "pattern": "www.marcuswalton.dev", "custom_domain": true }
  ]
}
