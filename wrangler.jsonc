{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "marcuswalton",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run the Worker before serving files so www and .co.uk requests can be redirected.
    "run_worker_first": true
  },
  // The vault's Worker, for its note counts (src/index.js). Called directly, not over the internet,
  // so bot protection on linux.marcuswalton.dev doesn't get in the way.
  "services": [{ "binding": "VAULT", "service": "linux-vault" }],
  "vars": {
    // Cloudflare Web Analytics site token (dashboard > Analytics & Logs > Web Analytics).
    // Leave empty to turn analytics off.
    "CF_ANALYTICS_TOKEN": "8d2b3be65cbb43f88304886cadf68fbe"
  },
  "routes": [
    { "pattern": "marcuswalton.dev", "custom_domain": true },
    { "pattern": "www.marcuswalton.dev", "custom_domain": true },
    // Redirected to marcuswalton.dev by src/index.js
    { "pattern": "marcuswalton.co.uk", "custom_domain": true },
    { "pattern": "www.marcuswalton.co.uk", "custom_domain": true }
  ]
}
